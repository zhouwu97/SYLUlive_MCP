# disabled、demo 或 production。默认 disabled 只暴露 system_status。
SYLULIVE_MCP_MODE=disabled

# 本地客户端使用 stdio；容器化 Agent Service 使用 streamable-http。
SYLULIVE_MCP_TRANSPORT=stdio
SYLULIVE_MCP_HOST=127.0.0.1
SYLULIVE_MCP_PORT=8000
SYLULIVE_MCP_PATH=/mcp
# JSON 数组；容器部署时加入 Agent 访问 MCP 使用的内部主机名。
SYLULIVE_MCP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
SYLULIVE_MCP_MAX_REQUEST_BYTES=1048576

# production 模式只访问 Go 内部 API；Grant 必须由 Go 按 Run 短期签发。
SYLULIVE_API_BASE=http://127.0.0.1:8080
# 仅 stdio 可配置进程 Grant；streamable-http 必须逐请求发送 Authorization Header。
SYLULIVE_MCP_GRANT=
SYLULIVE_API_TIMEOUT_SECONDS=30
SYLULIVE_API_MAX_RESPONSE_BYTES=2097152

# demo 模式只读取该目录下的公开样例。
SYLULIVE_DEMO_ROOT=./examples

SYLULIVE_MAX_INPUT_CHARS=30000
SYLULIVE_MAX_SOURCE_FILES=20
SYLULIVE_MAX_SOURCE_FILE_BYTES=1048576
SYLULIVE_ALLOW_PRIVATE_HTTP=false
SYLULIVE_LOG_LEVEL=INFO
