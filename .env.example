# 运行模式：live、fixture 或 disabled。
HY3_MODE=disabled

# Live 模式必须提供真实的 OpenAI-compatible Hy3 API 配置。
HY3_API_BASE=https://example.com/v1
HY3_API_KEY=
HY3_MODEL=hy3
HY3_TIMEOUT_SECONDS=60

# 所有本地示例和路径输入必须位于该目录中。
HY3_CAMPUS_ROOT=./examples
HY3_FIXTURE_ROOT=./tests/fixtures/hy3

HY3_MAX_INPUT_CHARS=30000
HY3_MAX_SOURCE_FILES=20
HY3_MAX_SOURCE_FILE_BYTES=1048576
HY3_ALLOW_PRIVATE_HTTP=false
HY3_LOG_LEVEL=INFO
HY3_DEFAULT_TEMPERATURE=0.9
HY3_DEFAULT_TOP_P=1.0
