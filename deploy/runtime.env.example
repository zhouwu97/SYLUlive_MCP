# 复制到 /etc/sylulive-mcp/runtime.env，由管理员设置权限，不要提交真实密钥。
HY3_MODE=live
HY3_TOOL_PROFILE=sylulive_runtime
HY3_API_BASE=https://example.com/v1
HY3_API_KEY=
HY3_API_PROTOCOL=openai_chat_completions
HY3_MODEL=hy3
HY3_TIMEOUT_SECONDS=60
HY3_MAX_OUTPUT_TOKENS=2048
HY3_MAX_INPUT_CHARS=30000
HY3_MAX_OUTPUT_BYTES=131072
HY3_LOG_LEVEL=INFO
